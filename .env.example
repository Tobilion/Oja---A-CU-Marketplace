# Oja environment variables. Copy to .env (never commit .env).
# A fresh clone needs NONE of these: unset mode runs the offline demo database.

# Demo or public. Unset (or "demo") = demo mode: mock database, persona bar,
# demo banner, dev outbox, Reset demo data, full footer, local feedback queue.
# "public" = strict live mode: Supabase required, no demo UI at all.
VITE_APP_MODE=demo

# Supabase project credentials (public mode requires both).
# Get them from: Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Feedback destinations are compiled constants (no env needed):
# WhatsApp https://wa.me/2347073948340 and tobilobajagun@gmail.com.
# See src/config/appConfig.ts (FEEDBACK_WHATSAPP_NUMBER, FEEDBACK_EMAIL).
